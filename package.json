{
  "name": "scr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,vite -c blue,magenta \"bun run dev:server\" \"bun run dev:vite\"",
    "dev:server": "bun run --hot src/server/index.ts",
    "dev:vite": "bunx vite",
    "build": "bunx vite build",
    "start": "bun run src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "node node_modules/.bin/storybook dev -p 6006",
    "build-storybook": "node node_modules/.bin/storybook build"
  },
